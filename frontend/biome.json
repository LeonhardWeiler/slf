{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noDescendingSpecificity": "off"
			},
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	},
	"files": {
		"includes": ["**", "!dist"]
	}
}
